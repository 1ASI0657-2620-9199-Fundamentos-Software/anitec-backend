# Copy to deploy/azure/.secrets.env (ignored by git) and fill it in. Never commit real values and never paste them in
# chat, issues or the report. The deployment script reads this file and loads the values straight into Azure secrets.

# Connection string of the core database, in the SAME format as the ConnectionStrings__DefaultConnection variable that
# the core already uses (key=value pairs separated by semicolons, SslMode=Required for Aiven).
AIVEN_CONNECTION_STRING=

# Stripe secret key in TEST mode (starts with sk_test_). It is the same one used in the local .env.
STRIPE_SECRET_KEY=

# Signing secret of the Stripe webhook endpoint that points to the Azure gateway (starts with whsec_).
# It only exists after the first deployment; leave it empty until then.
STRIPE_WEBHOOK_SECRET_AZURE=

# Generated by the deployment script on its first run (do not fill in by hand):
# SUBSCRIPTIONS_DB_PASSWORD=
# MYSQL_ADMIN_PASSWORD=
# AZURE_SUFFIX=
# IMAGE_TAG=
# AZURE_JWT_SECRET=
