{
  "Gateway": {
    "SupportedApiVersions": [ "v1" ],
    "ExposeStatus": false,
    "PassiveHealthWindowSeconds": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://anitec-frontend-cve3.onrender.com",
      "https://1asi0657-2620-9199-fundamentos-software.github.io",
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "subscription-plans": {
        "ClusterId": "subscriptions",
        "Order": 1,
        "Match": { "Path": "/api/v1/subscription-plans/{**rest}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "subscriptions": {
        "ClusterId": "subscriptions",
        "Order": 1,
        "Match": { "Path": "/api/v1/subscriptions/{**rest}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "core": {
        "ClusterId": "core",
        "Order": 10,
        "Match": { "Path": "/{**rest}" },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      }
    },
    "Clusters": {
      "core": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "Destinations": {
          "api1": { "Address": "http://api1:8080" },
          "api2": { "Address": "http://api2:8080" }
        }
      },
      "subscriptions": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "Destinations": {
          "subscriptions": { "Address": "http://subscriptions:8080" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
