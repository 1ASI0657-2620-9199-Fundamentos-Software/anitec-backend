# Copy this file to .env (ignored by git) and change the values. They are only for the local compose environment.
MYSQL_ROOT_PASSWORD=change-me-local-only
TOKEN_SECRET=change-me-local-only-use-at-least-32-characters
# Seconds between two readings accepted from the same device (60 in production)
TELEMETRY_MIN_INTERVAL_SECONDS=10

# Password of the MySQL user of the Subscriptions service (its own database, anitec-subscriptions)
SUBSCRIPTIONS_DB_PASSWORD=change-me-local-only

# Stripe in TEST mode only. Leave them empty to run without Stripe: the checkout then answers that it is not configured.
# Never commit real values and never paste them in chats or documents.
#   STRIPE_SECRET_KEY: sk_test_... from the Stripe dashboard (test environment)
#   STRIPE_WEBHOOK_SECRET: whsec_... printed by "stripe listen --print-secret" (the CLI must use the same environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the browser returns after paying (the frontend). Default: http://localhost:5173
# FRONTEND_URL=http://localhost:5173
